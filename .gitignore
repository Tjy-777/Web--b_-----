# 秘密情報を書いた設定ファイル
config.js
config.php

# 将来、環境変数管理に移行した場合に備えて
.env

# エディタの設定フォルダ
.vscode/
.idea/

# 依存パッケージ（将来npm等を使う場合に備えて）
node_modules/

# Windowsのシステムが自動生成するゴミファイル
Thumbs.db
ehthumbs.db
Desktop.ini

# macOSのシステムが自動生成するゴミファイル
.DS_Store

# ログファイルやキャッシュ
*.log

# 本番DBのバックアップ・ダンプファイル（実データを含むため）
# ※ sql/schema.sql, sql/users_schema.sql のような「構造のみ」のファイルは
#   Git管理したいので、ダンプファイルには dump_ を頭に付けるなど命名を分けてください
dump_*.sql